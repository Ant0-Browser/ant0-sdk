{
  "name": "ant0-browser",
  "version": "0.2.2",
  "description": "Playwright SDK for launching a separately installed Ant0 Browser engine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test"
  },
  "dependencies": {
    "maxmind": "^4.3.0",
    "playwright-core": "^1.49.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/unzipper": "^0.10.11",
    "eslint": "^9.39.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "keywords": [
    "ant0-browser",
    "playwright",
    "puppeteer",
    "chromium",
    "fingerprint",
    "farbling",
    "automation",
    "browser-automation",
    "ai-agents",
    "browser-personas"
  ],
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Ant0-Browser/ant0-sdk",
  "bugs": {
    "url": "https://github.com/Ant0-Browser/ant0-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ant0-Browser/ant0-sdk.git",
    "directory": "node"
  }
}
